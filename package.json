    "@biomejs/biome": "^2.3.5",
    "bun-types": "^1.3.3",
    "typescript": "^5.9.3"
  },
  "description": "A window into OMP's native subagents, from inside Herdr \u2014 read-only, OMP's own TUI look, one tab per session.",
  "keywords": [
    "omp",
    "omp-plugin",
    "omp-extension",
    "oh-my-pi",
    "herdr",
    "subagents",
    "tui",
    "terminal",
    "viewer"
  ],
  "homepage": "https://github.com/fabzter/herdr-omp-lens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabzter/herdr-omp-lens.git"
  },
  "bugs": {
    "url": "https://github.com/fabzter/herdr-omp-lens/issues"
  },
  "author": "Fabrizio Hernandez",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/architecture.md",
    "docs/assets/*.gif"
