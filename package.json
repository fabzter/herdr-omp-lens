{
  "name": "herdr-omp-lens",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "omp": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests"
  },
  "dependencies": {
    "@oh-my-pi/pi-tui": "19.2.1",
    "@oh-my-pi/pi-wire": "19.2.1",
    "zod": "^4.1.13"
  },
